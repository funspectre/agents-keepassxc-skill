#!/usr/bin/env python3
"""argologin — log in to ArgoCD by project alias with the password from KeePassXC."""

import argparse
import json
import os
import ssl
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
from pathlib import Path

import yaml

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

import kpsec_core as kpsec  # noqa: E402

TARGET_CANDIDATES = [
    Path(os.environ["KPSEC_TARGETS"]) if os.environ.get("KPSEC_TARGETS") else None,
    Path.home() / ".config" / "kpsec" / "argocd.tsv",
    SCRIPT_DIR.parent / "targets" / "argocd.tsv",
]
ARGOCD_CONFIG = Path(os.environ.get("ARGOCD_CONFIG", Path.home() / ".config" / "argocd" / "config"))
TOKEN_TTL = int(os.environ.get("ARGOCD_TOKEN_TTL", 8 * 3600))
WRITE_VERBS = {"sync", "delete", "rollback", "terminate-op", "set", "unset", "patch",
               "create", "edit", "add", "rm", "remove", "generate-spec", "actions"}


def die(msg, code=1):
    print(f"argologin: {msg}", file=sys.stderr)
    sys.exit(code)


def targets_path():
    for candidate in TARGET_CANDIDATES:
        if candidate and candidate.exists():
            return candidate
    die("no alias file found; create ~/.config/kpsec/argocd.tsv "
        "(see targets/argocd.tsv.example in the skill repository)", 2)


def load_targets():
    targets = {}
    path = targets_path()
    for lineno, line in enumerate(path.read_text().splitlines(), 1):
        if not line.strip() or line.startswith("#"):
            continue
        try:
            alias, server, grpc_web, insecure, protected, ref = line.split("\t")
        except ValueError:
            die(f"{path}:{lineno}: expected 6 tab-separated fields", 2)
        targets[alias] = {
            "server": server,
            "grpc_web": grpc_web == "true",
            "insecure": insecure == "true",
            "protected": protected == "true",
            "ref": ref,
        }
    return targets


def ssl_ctx(target):
    if not target["insecure"]:
        return None
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    return ctx


def fetch_token(cfg, target):
    username = kpsec.resolve(cfg, target["ref"] + "#UserName", soft=True) or "admin"
    password = kpsec.resolve(cfg, target["ref"])
    if not password:
        die(f"no password behind {target['ref']}", 4)
    body = json.dumps({"username": username, "password": password}).encode()
    req = urllib.request.Request(f"https://{target['server']}/api/v1/session", data=body,
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=20, context=ssl_ctx(target)) as resp:
            token = json.load(resp).get("token")
    except urllib.error.HTTPError as e:
        die(f"{target['server']} replied {e.code}: {e.read().decode(errors='replace')[:200]}", 5)
    except Exception as e:
        die(f"cannot reach {target['server']}: {e}", 5)
    if not token:
        die("server returned no token", 5)
    return token


def get_token(cfg, alias, target, refresh=False):
    desc = f"kpsec:argocd:{alias}"
    if not refresh:
        cached = kpsec.keyctl_read(desc)
        if cached:
            return cached, True
    token = fetch_token(cfg, target)
    kpsec.keyctl_write(desc, token, TOKEN_TTL)
    return token, False


def write_argocd_config(alias, target, token, switch=True, path=None, merge=True):
    path = path or ARGOCD_CONFIG
    path.parent.mkdir(parents=True, exist_ok=True)
    data = {}
    if merge and path.exists():
        path.with_suffix(".bak").write_bytes(path.read_bytes())
        data = yaml.safe_load(path.read_text()) or {}
    server = target["server"]

    def upsert(section, key, value):
        items = data.setdefault(section, []) or []
        for i, item in enumerate(items):
            if item.get(key) == value[key]:
                items[i] = {**item, **value}
                break
        else:
            items.append(value)
        data[section] = items

    upsert("contexts", "name", {"name": alias, "server": server, "user": server})
    upsert("servers", "server", {"server": server, "grpc-web": target["grpc_web"],
                                 "grpc-web-root-path": "",
                                 **({"insecure": True} if target["insecure"] else {})})
    upsert("users", "name", {"name": server, "auth-token": token})
    if switch:
        data["current-context"] = alias
    path.touch(mode=0o600, exist_ok=True)
    path.write_text(yaml.safe_dump(data, sort_keys=True, default_flow_style=False))
    path.chmod(0o600)


def run_stateless(alias, target, token, command):
    """Keep the token in a tmpfs config that is removed once the command exits.

    ARGOCD_SERVER/ARGOCD_AUTH_TOKEN alone do not work: without a config file the
    CLI talks grpc-web over http:// and gets a 404.
    """
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", tempfile.gettempdir()))
    fd, name = tempfile.mkstemp(prefix="argologin-", suffix=".config", dir=runtime)
    os.close(fd)
    tmp = Path(name)
    try:
        write_argocd_config(alias, target, token, path=tmp, merge=False)
        env = os.environ.copy()
        env["ARGOCD_OPTS"] = f"{env.get('ARGOCD_OPTS', '')} --config {tmp}".strip()
        proc = subprocess.Popen(command, env=env, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT)
        kpsec.stream_redacted(proc, [token])
        return proc.wait()
    finally:
        tmp.unlink(missing_ok=True)


def guard_writes(alias, target, command):
    if not target["protected"] or os.environ.get("ARGO_ALLOW_WRITE"):
        return
    for word in command:
        if word in WRITE_VERBS:
            die(f"'{word}' mutates state on protected {alias} ({target['server']}). "
                f"Confirm with the user, then retry with ARGO_ALLOW_WRITE=1", 3)


def cmd_list(targets):
    for alias, t in targets.items():
        flags = " ".join(k for k in ("grpc_web", "insecure", "protected") if t[k])
        print(f"{alias:12} {t['server']:28} {t['ref']:26} {flags}")
    return 0


def main():
    p = argparse.ArgumentParser(prog="argologin", description=__doc__,
                                epilog="after -- : run a command with the token, leaving the config untouched")
    p.add_argument("alias", help="alias from argocd.tsv, or 'list'")
    p.add_argument("--refresh", action="store_true", help="ignore the cached token")
    p.add_argument("--no-switch", action="store_true", help="do not make this the current context")
    p.add_argument("--logout", action="store_true", help="drop the cached token")

    argv, command = sys.argv[1:], []
    if "--" in argv:
        sep = argv.index("--")
        argv, command = argv[:sep], argv[sep + 1:]
    args = p.parse_args(argv)

    targets = load_targets()
    if args.alias == "list":
        return cmd_list(targets)
    if args.alias not in targets:
        die(f"unknown alias '{args.alias}'. Available: {', '.join(targets)}", 2)
    target = targets[args.alias]

    if args.logout:
        dropped = kpsec.keyctl_unlink(f"kpsec:argocd:{args.alias}")
        print("token cache dropped" if dropped else "token cache was empty")
        return 0

    if command:
        guard_writes(args.alias, target, command)
    cfg = kpsec.load_config()
    token, cached = get_token(cfg, args.alias, target, refresh=args.refresh)

    if command:
        return run_stateless(args.alias, target, token, command)

    write_argocd_config(args.alias, target, token, switch=not args.no_switch)
    print(f"logged in to {target['server']} as context '{args.alias}' "
          f"({'cached token' if cached else 'fresh login'})")
    if target["protected"]:
        print("⛔ protected instance: no changes without explicit user confirmation")
    return 0


if __name__ == "__main__":
    sys.exit(main())
