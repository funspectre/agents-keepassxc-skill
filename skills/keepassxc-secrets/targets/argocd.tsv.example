# Copy to ~/.config/kpsec/argocd.tsv and edit. Fields are TAB-separated.
#
# alias      short name you type: `argologin <alias>`
# server     host without scheme
# grpc_web   true if the instance sits behind an ingress that cannot do HTTP/2
#            (nginx-ingress without ssl-passthrough — almost always true)
# insecure   true to skip TLS verification (self-signed certificates)
# protected  true to block mutating verbs unless ARGO_ALLOW_WRITE=1 is set
# ref        kp:// reference to the entry holding the password
#
# alias	server	grpc_web	insecure	protected	ref
staging	argocd.staging.example.com	true	false	false	kp://argocd/staging
production	argocd.example.com	true	false	true	kp://argocd/production
